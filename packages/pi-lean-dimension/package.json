{
	"name": "pi-lean-dimension",
	"version": "0.6.0",
	"description": "Bundles pi-lean-portal, pi-lean-search, and pi-lean-host: web browsing on Chromium or Firefox, extendable with any Playwright-based stealth backend, keyless SearXNG search, and REST API recipes with OAuth and local secrets. /web and /api toggles.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"web",
		"suite"
	],
	"license": "AGPL-3.0-only",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coreyryanhanson/pi-lean-dimension.git",
		"directory": "packages/pi-lean-dimension"
	},
	"files": [
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"test": "vitest run"
	},
	"pi": {
		"extensions": [
			"./node_modules/pi-lean-portal/index.ts",
			"./node_modules/pi-lean-search/index.ts",
			"./node_modules/pi-lean-host/index.ts"
		]
	},
	"dependencies": {
		"pi-lean-portal": "^0.6.0",
		"pi-lean-search": "^0.6.0",
		"pi-lean-host": "^0.6.0"
	},
	"bundledDependencies": [
		"pi-lean-portal",
		"pi-lean-search",
		"pi-lean-host"
	]
}
