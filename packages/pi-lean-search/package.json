{
	"name": "pi-lean-search",
	"version": "0.2.4",
	"description": "Pi extension. SearXNG search tool for Pi — pairs with pi-lean-portal's /web toggle; search-only installs are valid, or add it to a portal install for the full web-tools suite.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"searxng",
		"search",
		"web"
	],
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coreyryanhanson/pi-lean-dimension.git",
		"directory": "packages/pi-lean-search"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"LICENSE",
		"web-search-tool.ts",
		"search-config.ts",
		"verify-ship-manifest.ts",
		"ship-manifest.test.ts",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"prepack": "cp ../../LICENSE ./LICENSE",
		"test": "vitest run"
	},
	"dependencies": {
		"pi-tool-masking": "file:../../pi-tool-masking"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"pi-lean-portal": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"pi-lean-portal": {
			"optional": true
		}
	}
}
