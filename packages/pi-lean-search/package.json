{
	"name": "pi-lean-search",
	"version": "0.6.0",
	"description": "SearXNG web search for Pi. Self-hosted or public instance, no API keys or quotas; returns a setup message instead of erroring when unreachable. Pairs with pi-lean-portal's /web toggle or works standalone.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"searxng",
		"search",
		"web"
	],
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coreyryanhanson/pi-lean-dimension.git",
		"directory": "packages/pi-lean-search"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"LICENSE",
		"web-search-tool.ts",
		"search-config.ts",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"prepack": "cp ../../LICENSE ./LICENSE",
		"test": "vitest run"
	},
	"dependencies": {
		"pi-tool-masking": "^1.3.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"pi-lean-portal": "*"
	},
	"peerDependenciesMeta": {
		"pi-lean-portal": {
			"optional": true
		}
	}
}
