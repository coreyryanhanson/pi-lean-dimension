{
	"name": "pi-lean-host",
	"version": "0.0.1",
	"description": "BrowserGym evaluation harness for BrowserPlugin backends. Adapter-driven MiniWoB++ (and future WebArena/WorkArena) task pipeline: Python bridge via CDP attach, Node-plugin @e-ref action layer, TypeScript runMiniwobTask/benchPlugin API. Phase 1 complete: chromium Mode A adapter smoke test passes (click-test, rawReward > 0).",
	"keywords": [
		"pi-package",
		"pi-extension",
		"benchmark",
		"browsergym",
		"miniwob",
		"webarena"
	],
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/coreyryanhanson/pi-lean-dimension.git",
		"directory": "packages/pi-lean-host"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"README.md",
		"AGENTS.md",
		"LICENSE",
		"src/",
		"adapter/",
		"solvers/",
		"scripts/",
		"requirements.txt"
	],
	"scripts": {
		"prepack": "cp ../../LICENSE ./LICENSE",
		"test": "vitest run",
		"test:miniwob": "vitest run suites/miniwob-trivial.test.ts",
		"test:helper": "vitest run suites/miniwob-helper.test.ts",
		"setup:miniwob": "node scripts/setup-miniwob.mjs",
		"setup:venv": "node scripts/setup-venv.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"pi-lean-portal": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"pi-lean-portal": {
			"optional": true
		}
	},
	"devDependencies": {
		"playwright": "*"
	}
}
